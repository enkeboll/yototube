# Yoto Auth Cookie Secret
# Used for encrypting session cookies stored in the browser (AES-256-GCM)
# Auto-generated or optional in development; required in production
YOTO_AUTH_SECRET=your-secret-key-here

# Yoto Developer App Client ID
# Obtain by creating a free app at https://yoto.dev
YOTO_CLIENT_ID=

# Resend API Key (Optional, for feedback emails)
RESEND_API_KEY=your-resend-api-key-here
