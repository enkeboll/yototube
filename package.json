{
    "name": "yoto",
    "version": "1.0.0",
    "description": "yoto sync",
    "private": true,
    "type": "module",
    "keywords": [
        "yoto",
        "typescript",
        "svelte",
        "sveltekit",
        "tailwind",
        "bits-ui",
        "lucide",
        "eslint",
        "prettier",
        "vite",
        "vitest",
        "docker"
    ],
    "scripts": {
        "build": "vite build",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "dev": "vite dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "node build/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "typecheck:ci": "svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@lucide/svelte": "^1.65.0",
        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@yotoplay/oauth-device-code-flow": "^1.2.1",
        "@yotoplay/yoto-sdk": "^1.2.0",
        "better-sqlite3": "^13.0.3",
        "bits-ui": "^2.20.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "p-limit": "^7.3.0",
        "resend": "^6.10.0",
        "shell-escape": "^0.2.0",
        "svelte": "^5.57.3",
        "svelte-sonner": "^1.2.2",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@bradgarropy/eslint-config": "^3.1.2",
        "@tailwindcss/vite": "^4.1.13",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^22",
        "@types/shell-escape": "^0.2.3",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.39.2",
        "memfs": "^4.56.10",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.1.13",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.2",
        "vite": "^7.1.7",
        "vite-plugin-devtools-json": "^1.0.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^4.0.18"
    },
    "allowScripts": {
        "better-sqlite3": true,
        "esbuild": true,
        "fsevents": true,
        "sharp": true
    }
}
